#!/bin/bash
# Opens the launcher script in Terminal so the server's output stays visible
# and Ctrl-C can stop it. The script lives beside this .app by default.
HERE="$(cd -P "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
SCRIPT="$HERE/Pilot Logbook.command"
if [ ! -x "$SCRIPT" ]; then
  osascript -e 'display alert "Pilot Logbook" message "Could not find “Pilot Logbook.command” next to this app. Keep them in the same folder."'
  exit 1
fi
open -a Terminal "$SCRIPT"
